{
  "name": "agentci",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && npm run bundle",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/agentci.bundle.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts tests/*.integration.test.ts",
    "test:live": "node --experimental-strip-types --test tests/*.live.ts",
    "test:prompt-ab": "node --experimental-strip-types --test tests/moderation-prompt-ab.live.ts",
    "test:inject": "node --experimental-strip-types --test tests/messages-inject.live.ts",
    "test:inject:capture": "node --experimental-strip-types --test --test-name-pattern=injects tests/messages-inject.live.ts",
    "test:inject:bench": "node --experimental-strip-types --test --test-name-pattern=benchmark tests/messages-inject.live.ts",
    "test:release": "node --experimental-strip-types --test tests/release-entrypoint.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
