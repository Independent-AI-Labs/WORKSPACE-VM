#!/usr/bin/env bash
# AMI Orchestrator Shell Environment Setup
#
# This script configures the shell environment for the AMI Orchestrator system.
# All ami-* commands are loaded from extensions in ami/scripts/extensions/*.sh
#
# USAGE:
#   source agents/ami/scripts/shell/shell-setup           # Load environment temporarily
#   . agents/ami/scripts/shell/shell-setup               # Alternative to 'source' command
#
# PERMANENT INSTALLATION:
#   agents/ami/scripts/shell/shell-setup -install             # Install to ~/.bashrc
#   agents/ami/scripts/shell/shell-setup -install -no-backup # Install without backup
#
# UNINSTALL:
#   agents/ami/scripts/shell/shell-setup -uninstall          # Remove from ~/.bashrc

# ============================================================================
# Path calculation helper
# ============================================================================
_get_ami_root() {
    cd "$(dirname "${BASH_SOURCE[0]}")/../../../" && pwd
}

_get_agents_scripts() {
    echo "$AMI_ROOT/workspace/scripts"
}

# ============================================================================
# .bashrc / .zshrc marker management
# ============================================================================
BEGIN_MARKER="# >>> AMI Orchestrator >>>"
END_MARKER="# <<< AMI Orchestrator <<<"

_grep_rc() {
    local err
    err="$(mktemp)"
    grep -qF "$1" "$2" 2>"$err"
    local rc=$?
    if [[ -s "$err" ]]; then
        echo "[shell-setup] grep failed on $2: $(cat "$err")" >&2
    fi
    rm -f "$err"
    return $rc
}

# ============================================================================
# Install/Uninstall functions
# ============================================================================
_strip_legacy_markers() {
    local rc="$1"
    local content cat_err
    cat_err="$(mktemp)"
    content="$(cat "$rc" 2>"$cat_err")" || {
        [[ -s "$cat_err" ]] && echo "[shell-setup] failed to read $rc: $(cat "$cat_err")" >&2
        rm -f "$cat_err"
        return 0
    }
    rm -f "$cat_err"

    local changed=false

    if _grep_rc "$BEGIN_MARKER" "$rc"; then
        local tmp
        tmp=$(awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
            BEGIN { skip=0 }
            $0 == begin { skip=1; next }
            $0 == end   { skip=0; next }
            !skip { print }
        ' "$rc")
        if [[ "$tmp" != "$content" ]]; then
            echo "$tmp" > "$rc"
            content="$tmp"
            changed=true
        fi
    fi

    if _grep_rc "# AMI Orchestrator Shell Setup" "$rc"; then
        grep -vF "# AMI Orchestrator Shell Setup" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    if _grep_rc "# AMI PATH" "$rc"; then
        grep -vF "# AMI PATH" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    if _grep_rc "# AMI Orchestrator - auto-registered" "$rc"; then
        grep -vF "# AMI Orchestrator - auto-registered" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    if _grep_rc "# AMI Orchestrator - auto-installed" "$rc"; then
        grep -vF "# AMI Orchestrator - auto-installed" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    if _grep_rc "alias ami-run=" "$rc"; then
        grep -vF "alias ami-run=" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    if _grep_rc "AMI AGENT EXTENSIONS START" "$rc"; then
        local tmp
        tmp=$(awk '
            BEGIN { skip=0 }
            /AMI AGENT EXTENSIONS START/ { skip=1; next }
            /AMI AGENT EXTENSIONS END/   { skip=0; next }
            !skip { print }
        ' "$rc")
        echo "$tmp" > "$rc"
        changed=true
    fi

    if _grep_rc "shell-setup\" -welcome" "$rc"; then
        grep -vF "shell-setup\" -welcome" "$rc" > "${rc}.tmp" && \
            mv "${rc}.tmp" "$rc"
        changed=true
    fi

    [[ "$changed" == "true" ]] && echo -e "${BLUE}→${NC} Stripped legacy AMI markers from ~/$(basename "$rc")"
}

_install_to_bashrc() {
    local backup="${1:-true}"
    local force="${2:-false}"
    local bin_dir="${BOOT_LINUX_DIR:-${AMI_ROOT}/.boot-linux}/bin"
    local setup_script="$AMI_ROOT/workspace/scripts/shell/shell-setup"
    local candidates=("$HOME/.bashrc" "$HOME/.zshrc")

    for bashrc in "${candidates[@]}"; do
        [[ -f "$bashrc" ]] || continue

        if [[ "$backup" == "true" ]]; then
            cp "$bashrc" "${bashrc}.backup-$(date +%Y%m%d-%H%M%S)"
        fi

        _strip_legacy_markers "$bashrc"

        if _grep_rc "$BEGIN_MARKER" "$bashrc"; then
            if _grep_rc "$setup_script" "$bashrc" && [[ "$force" != "true" ]]; then
                echo -e "${YELLOW}⚠${NC} AMI shell setup already installed in ~/$(basename "$bashrc")"
                continue
            fi
            echo -e "${BLUE}→${NC} Updating AMI shell setup in ~/$(basename "$bashrc")..."
            _strip_legacy_markers "$bashrc"
        fi

        cat >> "$bashrc" <<'AMISHELL'
# >>> AMI Orchestrator >>>
AMISHELL
        echo "export PATH=\"${bin_dir}:\$PATH\"" >> "$bashrc"
        echo "[ -f \"$setup_script\" ] && . \"$setup_script\" -welcome" >> "$bashrc"
        cat >> "$bashrc" <<'AMISHELL'
# <<< AMI Orchestrator <<<
AMISHELL

        echo -e "${GREEN}✓${NC} Installed AMI shell setup to ~/$(basename "$bashrc")"
    done
    echo -e "${YELLOW}→${NC} Run 'source ~/.bashrc' or restart your shell to activate"
}

_uninstall_from_bashrc() {
    local candidates=("$HOME/.bashrc" "$HOME/.zshrc")

    for bashrc in "${candidates[@]}"; do
        [[ -f "$bashrc" ]] || continue

        if ! _grep_rc "$BEGIN_MARKER" "$bashrc" && \
           ! _grep_rc "# AMI Orchestrator Shell Setup" "$bashrc" && \
           ! _grep_rc "# AMI PATH" "$bashrc"; then
            echo -e "${YELLOW}⚠${NC} AMI shell setup not found in ~/$(basename "$bashrc")"
            continue
        fi

        cp "$bashrc" "${bashrc}.backup-$(date +%Y%m%d-%H%M%S)"
        _strip_legacy_markers "$bashrc"
        echo -e "${GREEN}✓${NC} Removed AMI shell setup from ~/$(basename "$bashrc")"
    done
    echo -e "${YELLOW}→${NC} Run 'source ~/.bashrc' or restart your shell to apply"
}

# ============================================================================
# Verify extensions are available in PATH
# ============================================================================
# Delegates to the Python manifest registry - single source of truth for what
# extensions exist (see ami/scripts/shell/extension_registry.py).
_verify_extensions() {
    local helper="$AMI_ROOT/workspace/scripts/shell/banner_helper.py"
    [[ -f "$helper" ]] || return 0
    # Use -mode doctor with -quiet: prints degraded/mismatched/unavailable
    # lists without running per-extension health checks. Any output means the
    # user has something to look at.
    local doctor py_err
    py_err="$(mktemp)"
    doctor="$(AMI_QUIET_MODE=1 python3 "$helper" -mode doctor 2>"$py_err")" || {
        [[ -s "$py_err" ]] && echo "[shell-setup] extension doctor check failed: $(cat "$py_err")" >&2
        rm -f "$py_err"
        return 0
    }
    rm -f "$py_err"
    if grep -qE 'Unavailable|Version-Mismatched' <<<"$doctor"; then
        echo "  Run 'make register-extensions' to install/repair commands" >&2
    fi
}

# ============================================================================
# Flag handling and initialization
# ============================================================================
export AMI_SHOW_WELCOME=0
export AMI_QUIET_MODE=0

if [[ "${1:-}" == "-install" ]]; then
    AMI_ROOT="$(_get_ami_root)"
    export AMI_ROOT
    AGENTS_SCRIPTS="$(_get_agents_scripts)"
    export AGENTS_SCRIPTS
    if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi

    backup="true"
    force="false"
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -no-backup) backup="false" ;;
            -force|-f) force="true" ;;
        esac
        shift
    done

    _install_to_bashrc "$backup" "$force"
    exit 0
elif [[ "${1:-}" == "-uninstall" ]]; then
    AMI_ROOT="$(_get_ami_root)"
    export AMI_ROOT
    AGENTS_SCRIPTS="$(_get_agents_scripts)"
    export AGENTS_SCRIPTS
    if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi

    _uninstall_from_bashrc
    exit 0
elif [[ "${1:-}" == "-welcome" ]]; then
    AMI_ROOT="$(_get_ami_root)"
    export AMI_ROOT
    AGENTS_SCRIPTS="$(_get_agents_scripts)"
    export AGENTS_SCRIPTS
    export AMI_SHOW_WELCOME=1
    if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi
    cd "$AMI_ROOT"
elif [[ "${1:-}" == "-quiet" ]] || [[ "${1:-}" == "-q" ]]; then
    AMI_ROOT="$(_get_ami_root)"
    export AMI_ROOT
    AGENTS_SCRIPTS="$(_get_agents_scripts)"
    export AGENTS_SCRIPTS
    export AMI_QUIET_MODE=1
    if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi
    cd "$AMI_ROOT"
else
    AMI_ROOT="$(_get_ami_root)"
    export AMI_ROOT
    AGENTS_SCRIPTS="$(_get_agents_scripts)"
    export AGENTS_SCRIPTS
    if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi
    cd "$AMI_ROOT"
fi

# ============================================================================
# Environment setup
# ============================================================================
if ! source "$AGENTS_SCRIPTS/shell/ami-banner.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/shell/ami-banner.sh" >&2; return 1; fi

AMI_QUIET_MODE=${AMI_QUIET_MODE:-0}

if [[ "$AMI_QUIET_MODE" != "1" ]]; then
    _ami_echo "${BLUE}🚀 Setting up AMI Orchestrator shell environment...${NC}"
fi

# Setup PATH and PYTHONPATH
if ! source "$AGENTS_SCRIPTS/utils/env_setup.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/utils/env_setup.sh" >&2; return 1; fi
setup_paths

# Playwright browsers path (installed to .boot-linux/ instead of ~/.cache/)
export PLAYWRIGHT_BROWSERS_PATH="$AMI_ROOT/.boot-linux/playwright-browsers"

# Headless X server for browser automation (Xvfb on display :99)
export DISPLAY="${DISPLAY:-:99}"

# AMI SSH keys - auto-add to ssh-agent if project .ssh/ keys exist
_ami_ssh_setup() {
    local ssh_dir="$AMI_ROOT/.ssh"
    [[ -d "$ssh_dir" ]] || return 0
    command -v ssh-add &>/dev/null || return 0
    for key in "$ssh_dir"/*; do
        [[ -f "$key" ]] || continue
        [[ "$key" = *.pub ]] && continue
        [[ "$(basename "$key")" = known_hosts ]] && continue
        [[ "$(basename "$key")" = config ]] && continue
        local fp keygen_err
        keygen_err="$(mktemp)"
        fp="$(ssh-keygen -lf "$key" 2>"$keygen_err" | awk '{print $2}')"
        [[ -s "$keygen_err" ]] && echo "[shell-setup] ssh-keygen failed on $key: $(cat "$keygen_err")" >&2
        rm -f "$keygen_err"
        local ssh_list ssh_list_err
        ssh_list_err="$(mktemp)"
        ssh_list="$(ssh-add -l 2>"$ssh_list_err")"
        [[ -s "$ssh_list_err" ]] && echo "[shell-setup] ssh-add -l failed: $(cat "$ssh_list_err")" >&2
        rm -f "$ssh_list_err"
        if [[ -n "$fp" ]] && grep -qF "$fp" <<<"$ssh_list"; then
            continue
        fi
        local add_err
        add_err="$(mktemp)"
        ssh-add "$key" 2>"$add_err" || {
            [[ -s "$add_err" ]] && echo "[shell-setup] ssh-add failed for $key: $(cat "$add_err")" >&2
        }
        rm -f "$add_err"
    done
}
_ami_ssh_setup
unset _ami_ssh_setup

# Import helper functions
if ! source "$AGENTS_SCRIPTS/utils/module_helpers.sh"; then echo "[shell-setup] failed to source $AGENTS_SCRIPTS/utils/module_helpers.sh" >&2; return 1; fi

# Verify all extensions are available
_verify_extensions

# ============================================================================
# Aliases
# ============================================================================
alias @="oc"
alias msg="oc"

# ============================================================================
# Display banner on welcome
# ============================================================================
if [[ "${AMI_SHOW_WELCOME:-0}" == "1" ]] && [[ "${AMI_QUIET_MODE:-0}" != "1" ]]; then
    display_banner
    display_system_status
fi
