#!/usr/bin/env bash
set -euo pipefail

# rules - manage add-user-message-context.js rules/hooks for opencode.
#
#   rules                             → display rule table, redeploy
#   rules hooks                       → display hook table, redeploy
#   rules add -r REGEX -t TEXT        → add a user-context rule
#   rules hooks add -r REGEX -t TEXT  → add an assistant-response hook
#   rules delete NUM                  → delete rule N
#   rules hooks delete NUM            → delete hook N
#   rules update NUM -r REGEX -t TEXT        → update rule N
#   rules hooks update NUM -r REGEX -t TEXT  → update hook N

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" && ! -f "$AMI_ROOT/pyproject.toml" ]]; do
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done

TEMPLATE="$AMI_ROOT/workspace/config/opencode/plugins/add-user-message-context.template.js"
USERFILE="$AMI_ROOT/workspace/config/opencode/plugins/add-user-message-context.js"
DEPLOY_DIR="${HOME}/.config/opencode/plugins"
DEPLOY_FILE="${DEPLOY_DIR}/add-user-message-context.js"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

_err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; exit 1; }
_ok()   { echo -e "${GREEN}[OK]${NC} $*"; }

_init_userfile() {
    if [[ ! -f "$USERFILE" ]]; then
        [[ ! -f "$TEMPLATE" ]] && _err "Template not found: $TEMPLATE"
        cp "$TEMPLATE" "$USERFILE"
        _ok "Created $USERFILE from template"
    fi
}

_deploy() { mkdir -p "$DEPLOY_DIR"; cp "$USERFILE" "$DEPLOY_FILE"; }

_remind() {
    echo ""
    echo -e "${BOLD}Restart all opencode sessions to pick up changes.${NC}"
    echo ""
}

# Parse { regex, instruction } blocks within a section.
# $1 = file, $2 = section name ("RULES" or "BLOCK_PATTERNS")
# Output: N|regex|/.../  and  N|instruction|...
_parse_blocks() {
    local file="$1" section="$2"
    local n=0 in_block=0 in_section=0 waiting_inst=0
    while IFS= read -r line; do
        if [[ "$line" =~ ^const[[:space:]]+${section}[[:space:]]* ]]; then
            in_section=1; in_block=0; n=0; waiting_inst=0
            continue
        fi
        [[ $in_section -eq 0 ]] && continue
        # End of this section's array
        if [[ "$line" == "]" ]]; then
            in_section=0; in_block=0
            continue
        fi
        if [[ "$line" =~ ^[[:space:]]*\{$ ]]; then
            in_block=1; n=$((n + 1)); waiting_inst=0
            continue
        fi
        if [[ $in_block -eq 1 ]]; then
            if [[ "$line" =~ ^[[:space:]]*regex:[[:space:]]*(/[^/]+/[a-z]*),?$ ]]; then
                echo "${n}|regex|${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^[[:space:]]*instruction:[[:space:]]*\"(.+)\" ]]; then
                echo "${n}|instruction|${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^[[:space:]]*instruction: ]]; then
                waiting_inst=1
            elif [[ $waiting_inst -eq 1 && "$line" =~ \"(.+)\" ]]; then
                echo "${n}|instruction|${BASH_REMATCH[1]}"
                waiting_inst=0
            elif [[ "$line" =~ ^[[:space:]]*\},?$ ]]; then
                in_block=0; waiting_inst=0
            fi
        fi
    done < "$file"
}

# Display a parsed block list
_display_blocks() {
    local title="$1" file="$2" section="$3"
    echo ""
    echo -e "${BOLD}${title}${NC}"
    echo -e "${DIM}────────────────────────────────────────────────────${NC}"
    echo ""
    local current_regex=""
    while IFS='|' read -r num field value; do
        case "$field" in
            regex) current_regex="$value" ;;
            instruction)
                [[ -n "$current_regex" ]] && \
                    printf "  ${GREEN}%2s${NC}  ${CYAN}%-14s${NC}  %s\n" "$num" "$current_regex" "$value"
                current_regex=""
                ;;
        esac
    done < <(_parse_blocks "$file" "$section")
}

# Count blocks in a section
_count_blocks() {
    local file="$1" section="$2"
    local n=0 in_section=0
    while IFS= read -r line; do
        if [[ "$line" =~ ^const[[:space:]]+${section}[[:space:]]* ]]; then
            in_section=1; continue
        fi
        if [[ $in_section -eq 1 && "$line" == "]" ]]; then
            break
        fi
        [[ $in_section -eq 1 && "$line" =~ ^[[:space:]]*\{$ ]] && n=$((n + 1))
    done < "$file"
    echo "$n"
}

# --- RULES commands ---

cmd_list() {
    _init_userfile; _deploy
    _display_blocks "Context Rules - injected on every user message" "$USERFILE" "RULES"
    _remind
}

cmd_add() {
    local regex="" text=""
    while [[ $# -gt 0 ]]; do case "$1" in
        -r) regex="$2"; shift 2 ;; -t) text="$2"; shift 2 ;; *) _err "Unknown flag: $1" ;;
    esac; done
    [[ -z "$regex" ]] && _err "-r REGEX required"
    [[ -z "$text" ]]  && _err "-t TEXT required"
    _init_userfile
    _insert_block "$USERFILE" "RULES" "$regex" "$text"
    _ok "Rule added"
    cmd_list
}

cmd_delete() {
    local num="${1:-}"
    [[ -z "$num" ]] && _err "Usage: rules delete NUM"
    _init_userfile
    _delete_block "$USERFILE" "RULES" "$num"
    _ok "Rule $num deleted"
    cmd_list
}

cmd_update() {
    local num="${1:-}" regex="" text=""
    if [[ "$num" =~ ^[0-9]+$ ]]; then shift; else _err "First arg must be NUM"; fi
    while [[ $# -gt 0 ]]; do case "$1" in
        -r) regex="$2"; shift 2 ;; -t) text="$2"; shift 2 ;; *) _err "Unknown flag: $1" ;;
    esac; done
    [[ -z "$regex" ]] && _err "-r REGEX required"
    [[ -z "$text" ]]  && _err "-t TEXT required"
    _init_userfile
    _delete_block "$USERFILE" "RULES" "$num"
    _insert_block "$USERFILE" "RULES" "$regex" "$text"
    _ok "Rule $num updated"
    cmd_list
}

# --- HOOKS commands ---

cmd_hooks() {
    _init_userfile; _deploy
    _display_blocks "Assistant Response Hooks - fires when assistant uses matched words" "$USERFILE" "BLOCK_PATTERNS"
    _remind
}

cmd_hooks_add() {
    local regex="" text=""
    while [[ $# -gt 0 ]]; do case "$1" in
        -r) regex="$2"; shift 2 ;; -t) text="$2"; shift 2 ;; *) _err "Unknown flag: $1" ;;
    esac; done
    [[ -z "$regex" ]] && _err "-r REGEX required"
    [[ -z "$text" ]]  && _err "-t TEXT required"
    _init_userfile
    _insert_block "$USERFILE" "BLOCK_PATTERNS" "$regex" "$text"
    _ok "Hook added"
    cmd_hooks
}

cmd_hooks_delete() {
    local num="${1:-}"
    [[ -z "$num" ]] && _err "Usage: rules hooks delete NUM"
    _init_userfile
    _delete_block "$USERFILE" "BLOCK_PATTERNS" "$num"
    _ok "Hook $num deleted"
    cmd_hooks
}

cmd_hooks_update() {
    local num="${1:-}" regex="" text=""
    if [[ "$num" =~ ^[0-9]+$ ]]; then shift; else _err "First arg must be NUM"; fi
    while [[ $# -gt 0 ]]; do case "$1" in
        -r) regex="$2"; shift 2 ;; -t) text="$2"; shift 2 ;; *) _err "Unknown flag: $1" ;;
    esac; done
    [[ -z "$regex" ]] && _err "-r REGEX required"
    [[ -z "$text" ]]  && _err "-t TEXT required"
    _init_userfile
    _delete_block "$USERFILE" "BLOCK_PATTERNS" "$num"
    _insert_block "$USERFILE" "BLOCK_PATTERNS" "$regex" "$text"
    _ok "Hook $num updated"
    cmd_hooks
}

# --- block-level helpers ---

# Insert a { regex, instruction } block before the closing ] of $section
_insert_block() {
    local file="$1" section="$2" regex="$3" text="$4"
    local tmp in_section=0
    tmp="$(mktemp)"
    while IFS= read -r line; do
        if [[ "$line" =~ ^const[[:space:]]+${section}[[:space:]]* ]]; then
            in_section=1
        fi
        if [[ $in_section -eq 1 && "$line" == "]" ]]; then
            echo "  {" >> "$tmp"
            echo "    regex: ${regex}," >> "$tmp"
            echo '    instruction:' >> "$tmp"
            echo "      \"## ${text}\"," >> "$tmp"
            echo "  }," >> "$tmp"
            echo "]" >> "$tmp"
            in_section=0
            continue
        fi
        echo "$line" >> "$tmp"
    done < "$file"
    mv "$tmp" "$file"
}

# Delete the Nth block within $section
_delete_block() {
    local file="$1" section="$2" num="$3"
    local count
    count=$(_count_blocks "$file" "$section")
    [[ "$num" -lt 1 || "$num" -gt "$count" ]] && _err "Entry $num out of range (1-$count)"
    local tmp n=0 in_section=0 in_block=0 skip=0
    tmp="$(mktemp)"
    while IFS= read -r line; do
        if [[ "$line" =~ ^const[[:space:]]+${section}[[:space:]]* ]]; then
            in_section=1; n=0; in_block=0; skip=0
        fi
        if [[ $in_section -eq 1 ]]; then
            if [[ "$line" =~ ^[[:space:]]*\{$ ]]; then
                n=$((n + 1)); in_block=1
                [[ $n -eq $num ]] && skip=1
            fi
            if [[ "$line" == "]" ]]; then
                in_section=0; in_block=0; skip=0
            elif [[ $in_block -eq 1 && "$line" =~ ^[[:space:]]*\},?$ ]]; then
                in_block=0
                [[ $skip -eq 1 ]] && { skip=0; continue; }
            fi
        fi
        [[ $skip -eq 1 ]] && continue
        echo "$line" >> "$tmp"
    done < "$file"
    mv "$tmp" "$file"
}

# --- main ---
case "${1:-list}" in
    hooks)
        shift
        case "${1:-list}" in
            list|"") cmd_hooks ;;
            add)    shift; cmd_hooks_add "$@" ;;
            delete) shift; cmd_hooks_delete "${1:-}" ;;
            update) shift; cmd_hooks_update "$@" ;;
            *) _err "Unknown hooks command: $1" ;;
        esac
        ;;
    list|"")     cmd_list ;;
    add)         shift; cmd_add "$@" ;;
    delete)      shift; cmd_delete "${1:-}" ;;
    update)      shift; cmd_update "$@" ;;
    --help|-h)
        echo "Usage: rules [COMMAND]"
        echo ""
        echo "  rules                                  Show rules, redeploy"
        echo "  rules hooks                            Show response hooks, redeploy"
        echo "  rules add -r REGEX -t TEXT             Add a rule"
        echo "  rules hooks add -r REGEX -t TEXT       Add a response hook"
        echo "  rules delete NUM                        Delete rule N"
        echo "  rules hooks delete NUM                  Delete hook N"
        echo "  rules update NUM -r REGEX -t TEXT       Update rule N"
        echo "  rules hooks update NUM -r REGEX -t TEXT Update hook N"
        echo ""
        echo "Template: $TEMPLATE"
        echo "Userfile: $USERFILE"
        echo "Deploy:   $DEPLOY_FILE"
        ;;
    *) _err "Unknown command: $1" ;;
esac
