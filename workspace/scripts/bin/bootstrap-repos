#!/usr/bin/env bash
# bootstrap-repos: clone-if-missing every workspace repo listed in
# the AGENTS root moon.yml's `metadata.workspaceClones` block.
#
# Replaces the hardcoded `ensure-ci` / `ensure-dataops` Makefile
# targets with a single data-driven walker. Mandatory entries always
# clone; optional entries opt-in via --include <id>,<id> or --all.
# Optional `minTag` enforcement: abort if the cloned working tree's
# nearest tag is older than the declared minimum.
#
# Chicken-egg-safe: this script runs BEFORE moon may exist on the
# box (it might be the first thing the user runs after cloning AMI-
# AGENTS). YAML parsing uses .boot-linux/bin/python which is set up
# by bootstrap_python.sh in bootstrap-core, well before any project-
# graph operation.
#
# Usage:
#   bootstrap-repos                           # mandatory only
#   bootstrap-repos --include workspace-portal      # mandatory + portal
#   bootstrap-repos --include workspace-portal,ami-srp
#   bootstrap-repos --all                     # mandatory + ALL optional
#   bootstrap-repos --pull                    # also git-pull existing repos
#   bootstrap-repos --include workspace-portal --pull

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Find WORKSPACE-VM root by walking up to the dir containing pyproject.toml + moon.yml.
AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" ]]; do
    if [[ -f "$AMI_ROOT/pyproject.toml" && -f "$AMI_ROOT/moon.yml" ]]; then
        break
    fi
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done
if [[ "$AMI_ROOT" == "/" ]]; then
    echo "ERROR: could not locate WORKSPACE-VM root (pyproject.toml + moon.yml) from $SCRIPT_DIR" >&2
    exit 1
fi

CLONES_YAML="$AMI_ROOT/workspace/config/workspace-clones.yaml"
PYTHON="$AMI_ROOT/.boot-linux/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    # Fall back to system python3 if .boot-linux isn't there yet (very-cold-start).
    PYTHON="$(command -v python3)" || {
        echo "[bootstrap-repos] system python3 not found in PATH" >&2
        PYTHON=""
    }
    if [[ -z "$PYTHON" ]]; then
        echo "ERROR: no python found (.boot-linux/bin/python missing AND system python3 missing)" >&2
        exit 1
    fi
fi

# --- reconstruct SSH env when invoked under sudo ---
# sudo's default env_keep excludes SSH_AUTH_SOCK and rewrites HOME to
# /root, so any subsequent `git clone` / `git pull --ff-only` cannot
# reach the operator's ssh-agent and fails with
# "Permission denied (publickey)". When SUDO_USER is set and the env
# is missing, walk the /proc ancestor chain to find the operator's
# original login shell (which still carries both vars in its environ)
# and re-export them. Lets `sudo make build-guard` work without the
# operator having to pass --preserve-env flags.
restore_ssh_env_under_sudo() {
    if [[ -z "${SUDO_USER:-}" ]]; then
        return 0
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && "${HOME:-}" != "/root" ]]; then
        return 0
    fi
    local pid=$$ next hops=0
    local env_text=""
    local found_sock="" found_home=""
    while [[ "$pid" != "1" && $hops -lt 32 ]]; do
        # /proc/<pid>/status: read into var first so a vanished pid is a
        # soft warning, not a script-killing awk non-zero under set -e.
        if [[ ! -r "/proc/$pid/status" ]]; then
            break
        fi
        next=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status")
        if [[ -z "$next" || "$next" == "0" ]]; then
            break
        fi
        if [[ -r "/proc/$next/environ" ]]; then
            # Parse the ancestor environ in a single awk pass: no grep (no
            # exit-1-on-no-match), no head (no SIGPIPE under pipefail).
            # tr converts NUL to newline so awk sees one var per line.
            env_text=$(tr '\0' '\n' < "/proc/$next/environ")
            found_sock=$(awk -F= '/^SSH_AUTH_SOCK=/ {sub(/^SSH_AUTH_SOCK=/, ""); print; exit}' <<<"$env_text")
            found_home=$(awk -F= '/^HOME=/ {sub(/^HOME=/, ""); print; exit}' <<<"$env_text")
            if [[ -n "$found_sock" && -n "$found_home" ]]; then
                export SSH_AUTH_SOCK="$found_sock"
                export HOME="$found_home"
                echo "[bootstrap-repos] restored SSH_AUTH_SOCK + HOME from ancestor pid=$next (SUDO_USER=$SUDO_USER) via /proc walk" >&2
                return 0
            fi
        fi
        pid=$next
        hops=$((hops + 1))
    done
    echo "[bootstrap-repos] WARNING: SUDO_USER=$SUDO_USER but SSH_AUTH_SOCK not found in any ancestor environ; git pull/clone will fail with Permission denied (publickey)" >&2
}
restore_ssh_env_under_sudo

# --- argument parsing ---
INCLUDE_OPTIONAL=()
PULL=0
ALL_OPTIONAL=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --include)
            IFS=',' read -ra _splits <<<"$2"
            INCLUDE_OPTIONAL+=("${_splits[@]}")
            shift 2
            ;;
        --all)
            ALL_OPTIONAL=1
            shift
            ;;
        --pull)
            PULL=1
            shift
            ;;
        -h|--help)
            sed -n '2,22p' "$0"
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# --- read workspaceClones via python ---
# Output one line per entry: id|remote|path|mandatory|minTag
ENTRIES=$("$PYTHON" - "$CLONES_YAML" <<'PY'
import sys

clones_yaml = sys.argv[1]
with open(clones_yaml) as f:
    text = f.read()

# Minimal YAML reader scoped to workspaceClones.<id>.<key>: 'value'.
# Avoids requiring PyYAML at this bootstrap stage.
in_clones = False
current_id = None
entries = {}

for raw in text.splitlines():
    line = raw.rstrip()
    if not line or line.lstrip().startswith("#"):
        continue
    indent = len(line) - len(line.lstrip())
    stripped = line.strip()

    if indent == 0:
        in_clones = (stripped == "workspaceClones:")
        current_id = None
        continue
    if in_clones and indent == 2 and stripped.endswith(":"):
        current_id = stripped[:-1].strip()
        entries[current_id] = {}
        continue
    if in_clones and indent == 4 and current_id and ":" in stripped:
        key, _, value = stripped.partition(":")
        value = value.strip()
        if (value.startswith("'") and value.endswith("'")) or (value.startswith('"') and value.endswith('"')):
            value = value[1:-1]
        entries[current_id][key.strip()] = value

for eid, fields in entries.items():
    remote = fields.get("remote", "")
    path = fields.get("path", "")
    mandatory = fields.get("mandatory", "false").lower() == "true"
    min_tag = fields.get("minTag", "")
    print(f"{eid}|{remote}|{path}|{'true' if mandatory else 'false'}|{min_tag}")
PY
)

if [[ -z "$ENTRIES" ]]; then
    echo "ERROR: no workspaceClones entries found in $CLONES_YAML" >&2
    exit 1
fi

# --- decide which entries to process ---
declare -A include_set
for id in "${INCLUDE_OPTIONAL[@]}"; do
    include_set["$id"]=1
done

processed=0
skipped=0
errors=0

while IFS='|' read -r entry_id remote path mandatory min_tag; do
    [[ -z "$entry_id" ]] && continue

    if [[ "$mandatory" != "true" && $ALL_OPTIONAL -eq 0 && -z "${include_set[$entry_id]:-}" ]]; then
        skipped=$((skipped + 1))
        continue
    fi

    target="$AMI_ROOT/$path"
    if [[ ! -d "$target/.git" ]]; then
        echo "📦 cloning $entry_id from $remote → $path"
        if ! git clone "$remote" "$target"; then
            echo "ERROR: failed to clone $entry_id from $remote" >&2
            errors=$((errors + 1))
            continue
        fi
        processed=$((processed + 1))
    else
        if [[ $PULL -eq 1 ]]; then
            echo "🔄 pulling $entry_id at $path"
            if ! ( cd "$target" && git pull --ff-only ); then
                echo "WARNING: $entry_id pull failed (offline, dirty tree, or non-ff)" >&2
            fi
        fi
        processed=$((processed + 1))
    fi

    # minTag enforcement.
    if [[ -n "$min_tag" && -d "$target/.git" ]]; then
        # Get the nearest tag reachable from HEAD.
        _bs_tag_err="$(mktemp)"
        nearest_tag="$( cd "$target" && git describe -tags -abbrev=0 2>"$_bs_tag_err" )" || {
            if [[ -s "$_bs_tag_err" ]]; then
                echo "[bootstrap-repos] git describe failed for $entry_id: $(cat "$_bs_tag_err")" >&2
            fi
        }
        rm -f "$_bs_tag_err"
        if [[ -z "$nearest_tag" ]]; then
            echo "WARNING: $entry_id has no tags; cannot verify minTag=$min_tag" >&2
        else
            # Compare: minTag must be reachable from nearest_tag's history.
            _bs_mb_err="$(mktemp)"
            _bs_mb_rc=0
            ( cd "$target" && git merge-base -is-ancestor "$min_tag" HEAD 2>"$_bs_mb_err" ) || _bs_mb_rc=$?
            if [[ $_bs_mb_rc -ne 0 ]]; then
                if [[ -s "$_bs_mb_err" ]]; then
                    echo "[bootstrap-repos] merge-base check failed for $entry_id: $(cat "$_bs_mb_err")" >&2
                fi
                echo "ERROR: $entry_id is at $nearest_tag, declared minTag is $min_tag - workspace too old" >&2
                errors=$((errors + 1))
            fi
            rm -f "$_bs_mb_err"
        fi
    fi
done <<<"$ENTRIES"

if [[ $errors -gt 0 ]]; then
    echo "❌ bootstrap-repos finished with $errors error(s); $processed processed, $skipped optional skipped" >&2
    exit 1
fi

echo "✅ bootstrap-repos: $processed processed, $skipped optional skipped"
