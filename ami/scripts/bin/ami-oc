#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" && ! -f "$AMI_ROOT/pyproject.toml" ]]; do
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done
export AMI_ROOT && cd "$AMI_ROOT"
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    echo "ami-oc — opencode AI agent wrapper with AMI welcome context"
    echo "Usage: ami-oc [task...]"
    echo "  Without arguments: starts interactive opencode session"
    echo "  With arguments:    runs opencode with the given task"
    exit 0
fi
WELCOME=$("$AMI_ROOT/ami/scripts/bin/ami-welcome" 2>/dev/null || echo "AMI-AGENTS workspace")
if [[ $# -gt 0 ]]; then
    exec npx opencode run "$WELCOME"$'\n\n'"Task: $*" --dir "$AMI_ROOT"
else
    printf '%b\n' "$WELCOME" && echo ""
    exec npx opencode
fi
