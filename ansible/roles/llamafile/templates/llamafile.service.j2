[Unit]
Description=Llamafile server (model: {{ llama_model }}, gpu: {{ llamafile_gpu }})
After=network.target

[Service]
Type=exec
# Wrapper sets PATH, dlopen helper, GPU selection, and LLAMA_ARG_* tuning.
# The .llamafile must run bare (no CLI args) so embedded .args stays active.
ExecStart={{ llamafile_server_script }} {{ llamafile_path }}
EnvironmentFile=%h/.config/llamafile/llamafile-{{ llama_model }}.env
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=5

[Install]
WantedBy=default.target