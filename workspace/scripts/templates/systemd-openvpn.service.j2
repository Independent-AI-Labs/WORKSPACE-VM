[Unit]
Description=OpenVPN client
After=network.target
Before=opencode.service

[Service]
Type=simple
User=root
ExecStart=/opt/ami-agents/.boot-linux/bin/openvpn --config /etc/openvpn/client.ovpn
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
