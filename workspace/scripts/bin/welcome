#!/usr/bin/env bash
# welcome: Print the WORKSPACE Orchestrator banner
set -euo pipefail
SCRIPT_SOURCE="${SHG_SCRIPT_PATH:-${BASH_SOURCE[0]}}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$SCRIPT_SOURCE")")" && pwd)"
WORKSPACE_ROOT="$("$SCRIPT_DIR/pwd")"
export WORKSPACE_ROOT
exec bash "$WORKSPACE_ROOT/workspace/scripts/shell/workspace-banner.sh" "$@"
