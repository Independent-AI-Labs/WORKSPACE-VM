#!/usr/bin/env bash
# run: Universal execution wrapper for AMI Orchestrator
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$("$SCRIPT_DIR/pwd")"
export AMI_ROOT

VENV_DIR="$AMI_ROOT/.venv"
VENV_PYTHON="/home/ami/AMI-AGENTS/.venv/bin/python"
BOOT_DIR="$AMI_ROOT/.boot-linux"

[[ -f "$AMI_ROOT/.env" ]] && export $(grep -v '^#' "$AMI_ROOT/.env" | xargs) || true

export PATH="$BOOT_DIR/bin:$VENV_DIR/bin:$PATH"

# Extension modules live under projects/<PROJECT>/ami/<pkg>/...
# Add every projects/<PROJECT> dir to PYTHONPATH so `ami.<pkg>` namespace
# imports resolve against the workspace venv.
PROJECT_PATHS=""
if [[ -d "$AMI_ROOT/projects" ]]; then
    for project_dir in "$AMI_ROOT/projects"/*/; do
        [[ -d "${project_dir%/}/ami" ]] && PROJECT_PATHS="${project_dir%/}:${PROJECT_PATHS}"
    done
fi
export PYTHONPATH="$AMI_ROOT:${PROJECT_PATHS}${PYTHONPATH:-}"

if [[ "$#" -gt 0 && ("$1" == "-h" || "$1" == "--help") ]]; then
    echo "run: Universal execution wrapper for AMI Orchestrator"
    echo ""
    echo "Usage: run [subcommand] [args...]"
    echo ""
    echo "Subcommands: python, uv, node, npm, npx, cargo, rustc, go"
    exit 0
fi

if [[ "$#" -gt 0 && "$1" == "--version" ]]; then
    VERSION="$(git -C "$AMI_ROOT" describe --always --dirty 2>/dev/null || echo "unknown")"
    echo "run (AMI Orchestrator) ${VERSION}"
    exit 0
fi

KNOWN_CMDS="python uv node npm npx wrap bash sh tests cargo rustc go extras doctor"
if [[ $# -gt 0 ]] && [[ " $KNOWN_CMDS " == *" $1 "* ]]; then
    SUBCOMMAND="$1"
    shift
    ARGS=("$@")
elif [[ $# -gt 0 && -f "$1" ]]; then
    SUBCOMMAND="python"
    ARGS=("$@")
elif [[ $# -eq 0 ]]; then
    SUBCOMMAND="python"
    ARGS=()
else
    echo "Error: Unknown subcommand '$1'" >&2
    exit 1
fi

case "$SUBCOMMAND" in
    python)
        exec "$VENV_PYTHON" "${ARGS[@]}"
        ;;
    tests)
        exec "$VENV_DIR/bin/pytest" "${ARGS[@]}"
        ;;
    uv)
        exec "$BOOT_DIR/bin/uv" "${ARGS[@]}"
        ;;
    node)
        exec "$BOOT_DIR/bin/node" "${ARGS[@]}"
        ;;
    npm)
        exec "$BOOT_DIR/bin/npm" "${ARGS[@]}"
        ;;
    npx)
        exec "$BOOT_DIR/bin/npx" "${ARGS[@]}"
        ;;
    bash)
        exec bash "${ARGS[@]}"
        ;;
    sh)
        exec sh "${ARGS[@]}"
        ;;
    wrap)
        [[ ${#ARGS[@]} -lt 2 ]] && echo "Usage: run wrap <id> <cmd>" >&2 && exit 1
        SVC_ID="${ARGS[0]}"
        CMD=("${ARGS[@]:1}")
        R_DIR="$AMI_ROOT/.runtime/wrapped/$SVC_ID"
        mkdir -p "$R_DIR"
        PID_F="$R_DIR/pid.lock"
        [[ -f "$PID_F" ]] && kill -0 $(cat "$PID_F") 2>/dev/null && echo "Already running" >&2 && exit 1
        nohup "$0" "${CMD[@]}" > "$R_DIR/std.log" 2>&1 &
        echo $! > "$PID_F"
        echo "Started $SVC_ID (PID: $!)"
        ;;
    cargo)
        export RUSTUP_HOME="$BOOT_DIR/rust"
        export CARGO_HOME="$BOOT_DIR/rust"
        exec "$BOOT_DIR/rust/bin/cargo" "${ARGS[@]}"
        ;;
    rustc)
        export RUSTUP_HOME="$BOOT_DIR/rust"
        export CARGO_HOME="$BOOT_DIR/rust"
        exec "$BOOT_DIR/rust/bin/rustc" "${ARGS[@]}"
        ;;
    go)
        exec "$BOOT_DIR/go/bin/go" "${ARGS[@]}"
        ;;
    extras)
        exec "$VENV_PYTHON" "$AMI_ROOT/ami/scripts/shell/banner_helper.py" --mode extras "${ARGS[@]}"
        ;;
    doctor)
        exec "$VENV_PYTHON" "$AMI_ROOT/ami/scripts/shell/banner_helper.py" --mode doctor "${ARGS[@]}"
        ;;
esac
