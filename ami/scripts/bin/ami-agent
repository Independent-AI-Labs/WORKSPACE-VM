#!/usr/bin/env bash
# AMI Agent Entrypoint - Local Venv Mode
set -e

# Resolve project root by walking up to pyproject.toml. Lets this
# script live anywhere inside the repo without hard-coded relative
# paths back to the project root.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" && ! -f "$AMI_ROOT/pyproject.toml" ]]; do
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done

if [[ ! -f "$AMI_ROOT/pyproject.toml" ]]; then
    echo "CRITICAL: could not locate AMI project root (pyproject.toml) from $SCRIPT_DIR" >&2
    exit 1
fi

# Handle installation mode
if [[ "$1" == "-i" || "$1" == "--install" ]]; then
    echo "alias ami-agent='$AMI_ROOT/ami/scripts/bin/ami-agent'"
    exit 0
fi

VENV_PYTHON="/home/ami/AMI-AGENTS/.venv/bin/python"

if [[ ! -f "$VENV_PYTHON" ]]; then
    echo "CRITICAL: Local venv python not found at $VENV_PYTHON" >&2
    echo "Run 'uv sync' to create the environment." >&2
    exit 1
fi

exec "$VENV_PYTHON" -m ami.cli.main "$@"
