#!/usr/bin/env bash
# ops: System orchestration and container management for WORKSPACE Orchestrator
set -euo pipefail

SCRIPT_SOURCE="${SHG_SCRIPT_PATH:-${BASH_SOURCE[0]}}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$SCRIPT_SOURCE")")" && pwd)"
WORKSPACE_ROOT="$("$SCRIPT_DIR/pwd")"
export WORKSPACE_ROOT

VENV_DIR="$WORKSPACE_ROOT/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"
BOOT_DIR="$WORKSPACE_ROOT/.boot-linux"

if [[ -f "$WORKSPACE_ROOT/.env" ]]; then
    export $(grep -v '^#' "$WORKSPACE_ROOT/.env" | xargs)
fi

export PATH="$BOOT_DIR/bin:$VENV_DIR/bin:$PATH"

PROJECT_PATHS=""
if [[ -d "$WORKSPACE_ROOT/projects" ]]; then
    for project_dir in "$WORKSPACE_ROOT/projects"/*/; do
        [[ -d "${project_dir%/}/workspace" ]] && PROJECT_PATHS="${project_dir%/}:${PROJECT_PATHS}"
    done
fi
export PYTHONPATH="$WORKSPACE_ROOT:${PROJECT_PATHS}${PYTHONPATH:-}"

if [[ "$#" -gt 0 && ("$1" == "-h" || "$1" == "--help") ]]; then
    echo "ops: System orchestration and container management for WORKSPACE Orchestrator"
    echo ""
    echo "Usage: ops [subcommand] [args...]"
    echo ""
    echo "Subcommands: podman, systemd, ansible, ansible-playbook, ansible-galaxy, kubectl, helm, status, storage, cron"
    exit 0
fi

if [[ "$#" -gt 0 && "$1" == "--version" ]]; then
    if VERSION="$(git -C "$WORKSPACE_ROOT" describe --always --dirty 2>&1)"; then
        :
    else
        VERSION="unknown"
    fi
    echo "ops (WORKSPACE Orchestrator) ${VERSION}"
    exit 0
fi

KNOWN_CMDS="podman systemd ansible ansible-playbook ansible-galaxy kubectl helm status storage cron"
if [[ $# -gt 0 ]] && [[ " $KNOWN_CMDS " == *" $1 "* ]]; then
    SUBCOMMAND="$1"
    shift
    ARGS=("$@")
elif [[ $# -eq 0 ]]; then
    echo "ops: System orchestration and container management for WORKSPACE Orchestrator"
    echo ""
    echo "Usage: ops [subcommand] [args...]"
    echo ""
    echo "Subcommands: podman, systemd, ansible, ansible-playbook, ansible-galaxy, kubectl, helm, status, storage, cron"
    exit 0
else
    echo "Error: Unknown subcommand '$1'" >&2
    exit 1
fi

case "$SUBCOMMAND" in
    podman)
        exec "$BOOT_DIR/bin/podman" "${ARGS[@]}"
        ;;
    systemd)
        exec systemctl --user "${ARGS[@]}"
        ;;
    ansible|ansible-playbook|ansible-galaxy)
        exec "$BOOT_DIR/bin/$SUBCOMMAND" "${ARGS[@]}"
        ;;
    kubectl)
        export KUBECONFIG="${KUBECONFIG:-${HOME}/.kube/config:./.kube/config}"
        exec "$BOOT_DIR/bin/kubectl" "${ARGS[@]}"
        ;;
    helm)
        exec "$BOOT_DIR/bin/helm" "${ARGS[@]}"
        ;;
    status)
        exec "$VENV_PYTHON" "$WORKSPACE_ROOT/workspace/cli/status.py"
        ;;
    storage)
        exec "$VENV_PYTHON" "$WORKSPACE_ROOT/workspace/cli/storage.py" "${ARGS[@]}"
        ;;
    cron)
        exec "$BOOT_DIR/bin/cron" "${ARGS[@]}"
        ;;
esac
