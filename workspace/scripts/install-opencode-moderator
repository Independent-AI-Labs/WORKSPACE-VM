#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${LOCAL_RESPONSE_MODERATOR_REPO_ROOT:-$(cd "${SCRIPT_DIR}/../.." && pwd)}"
SOURCE_DIR="${REPO_ROOT}/workspace/config/opencode/plugins"
CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode"
PLUGIN_DIR="${CONFIG_ROOT}/plugins"
STATE_DIR="${PLUGIN_DIR}/.local-response-moderator"
RELEASES_DIR="${STATE_DIR}/releases"
CURRENT_LINK="${STATE_DIR}/current"
ENTRY_LINK="${PLUGIN_DIR}/local-response-moderator.js"
SOURCE_JS="${SOURCE_DIR}/local-response-moderator.js"
SOURCE_MACHINE="${SOURCE_DIR}/local-response-moderator-machine.js"
SOURCE_SH="${SOURCE_DIR}/local-response-moderator.sh"
SOURCE_CONFIG="${SOURCE_DIR}/local-response-moderator.template.json"

fail() {
  printf 'local-response-moderator: %s\n' "$*" >&2
  exit 1
}

validate_current() {
  [[ -L "$CURRENT_LINK" ]] || fail "no active release"
  local release
  release="$(readlink -f "$CURRENT_LINK")" || fail "active release target is invalid"
  [[ -d "$release" && "$release" == "$RELEASES_DIR"/* ]] || fail "active release escapes releases directory"
}

release_dir() {
  validate_current
  local release
  release="$(readlink -f "$CURRENT_LINK")"
  printf '%s\n' "$release"
}

validate_entry() {
  [[ -L "$ENTRY_LINK" ]] || fail "active OpenCode plugin entry is missing"
  local expected actual
  expected="$(readlink -f "${CURRENT_LINK}/local-response-moderator.js")" || fail "active release adapter is invalid"
  actual="$(readlink -f "$ENTRY_LINK")" || fail "active OpenCode plugin entry target is invalid"
  [[ "$actual" == "$expected" ]] || fail "active OpenCode plugin entry does not resolve to the current release adapter"
}

read_config() {
  local config="$1" valid
  valid="$(jq -e '.gateway_url == "http://127.0.0.1:9080/llamafile" and (.model | type == "string" and length > 0)' "$config")" \
    || fail "configuration must select the Workspace Gateway relay and a model"
  [[ "$valid" == "true" ]] || fail "configuration must select the Workspace Gateway relay and a model"
}

verify_gateway() {
  local config="$1"
  local gateway model models
  gateway="$(jq -er '.gateway_url' "$config")"
  model="$(jq -er '.model' "$config")"
  models="$(curl --fail --no-progress-meter --show-error --max-time 30 "${gateway}/v1/models")" \
    || fail "Gateway model query failed: ${gateway}/v1/models"
  local present
  present="$(jq -e --arg model "$model" '[.data[]?.id == $model] | any' <<<"$models")" \
    || fail "Gateway does not expose configured model: $model"
  [[ "$present" == "true" ]] || fail "Gateway does not expose configured model: $model"
}

verify_release() {
  local release="$1"
  [[ -f "${release}/local-response-moderator.js" ]] || fail "adapter missing from release"
  [[ -f "${release}/local-response-moderator-machine.js" ]] || fail "machine missing from release"
  [[ -x "${release}/local-response-moderator.sh" ]] || fail "classifier is not executable"
  [[ -f "${release}/config.json" ]] || fail "configuration missing from release"
  bash -n "${release}/local-response-moderator.sh"
  read_config "${release}/config.json"
  verify_gateway "${release}/config.json"
}

install() {
  if [[ -L "$CURRENT_LINK" ]]; then
    validate_current
  fi
  [[ -f "$SOURCE_JS" ]] || fail "adapter source missing: $SOURCE_JS"
  [[ -f "$SOURCE_MACHINE" ]] || fail "machine source missing: $SOURCE_MACHINE"
  [[ -x "$SOURCE_SH" ]] || fail "classifier source missing or not executable: $SOURCE_SH"
  [[ -f "$SOURCE_CONFIG" ]] || fail "configuration template missing: $SOURCE_CONFIG"
  bash -n "$SOURCE_SH"
  read_config "$SOURCE_CONFIG"
  verify_gateway "$SOURCE_CONFIG"
  if [[ -e "$ENTRY_LINK" || -L "$ENTRY_LINK" ]]; then
    [[ -L "$ENTRY_LINK" ]] || fail "refusing to replace non-moderator plugin entry"
    validate_entry
  fi

  mkdir -p "$RELEASES_DIR"
  local release_id stage release
  release_id="$(cksum "$SOURCE_JS" "$SOURCE_MACHINE" "$SOURCE_SH" "$SOURCE_CONFIG" | cksum | cut -d ' ' -f 1)"
  stage="${RELEASES_DIR}/.stage-${release_id}-$$"
  release="${RELEASES_DIR}/${release_id}"
  if [[ ! -d "$release" ]]; then
    trap 'rm -rf "$stage"' EXIT
    mkdir "$stage"
    cp "$SOURCE_JS" "${stage}/local-response-moderator.js"
    cp "$SOURCE_MACHINE" "${stage}/local-response-moderator-machine.js"
    cp "$SOURCE_SH" "${stage}/local-response-moderator.sh"
    cp "$SOURCE_CONFIG" "${stage}/config.json"
    chmod 0755 "${stage}/local-response-moderator.sh"
    verify_release "$stage"
    mv "$stage" "$release"
  fi
  verify_release "$release"
  ln -s "releases/${release_id}" "${STATE_DIR}/.current-${release_id}"
  mv -Tf "${STATE_DIR}/.current-${release_id}" "$CURRENT_LINK"
  ln -s ".local-response-moderator/current/local-response-moderator.js" "${PLUGIN_DIR}/.entry-${release_id}.js"
  mv -Tf "${PLUGIN_DIR}/.entry-${release_id}.js" "$ENTRY_LINK"
  trap - EXIT
  printf 'installed release: %s\n' "$release_id"
  printf 'destination: %s\n' "$release"
  jq -r '"gateway: \(.gateway_url)\nmodel: \(.model)"' "${release}/config.json"
  printf 'verification: passed\n'
  printf 'restart OpenCode to load the active moderator release\n'
}

verify() {
  local release
  release="$(release_dir)"
  validate_entry
  verify_release "$release"
  cmp "$SOURCE_JS" "${release}/local-response-moderator.js"
  cmp "$SOURCE_MACHINE" "${release}/local-response-moderator-machine.js"
  cmp "$SOURCE_SH" "${release}/local-response-moderator.sh"
  cmp "$SOURCE_CONFIG" "${release}/config.json"
  printf 'verified active moderator release: %s\n' "$release"
}

status() {
  local release
  release="$(release_dir)"
  printf 'active release: %s\n' "$release"
  jq -r '"gateway: \(.gateway_url)\nmodel: \(.model)"' "${release}/config.json"
  if cmp -s "$SOURCE_JS" "${release}/local-response-moderator.js" \
    && cmp -s "$SOURCE_MACHINE" "${release}/local-response-moderator-machine.js" \
    && cmp -s "$SOURCE_SH" "${release}/local-response-moderator.sh" \
    && cmp -s "$SOURCE_CONFIG" "${release}/config.json"; then
    printf 'source drift: none\n'
    return
  fi
  printf 'source drift: detected\n'
}

uninstall() {
  if [[ -e "$ENTRY_LINK" || -L "$ENTRY_LINK" ]]; then
    [[ -L "$ENTRY_LINK" ]] || fail "refusing to remove non-moderator plugin entry"
    validate_entry
    rm "$ENTRY_LINK"
  fi
  rm -rf "$STATE_DIR"
  printf 'uninstalled local response moderator; restart OpenCode to unload it\n'
}

case "${1:-install}" in
  install) install ;;
  verify) verify ;;
  status) status ;;
  uninstall) uninstall ;;
  *) fail "usage: $0 {install|verify|status|uninstall}" ;;
esac
