#!/usr/bin/env bash
# repo: Git repository server management CLI
# Wrapper for repo.py
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$("$SCRIPT_DIR/pwd")"
export AMI_ROOT

# Add .boot-linux/bin to PATH so git/ssh tools are available (bootstrapped tools)
export PATH="$AMI_ROOT/.boot-linux/bin:$PATH"

# Use venv from AMI_ROOT
exec "/home/ami/AMI-AGENTS/.venv/bin/python" "$SCRIPT_DIR/repo.py" "$@"
