[Unit]
Description=Hang evidence sampler (PSI/disk/mem/kernel to /mnt/ws-fast/diag)
Documentation=file://%h/.local/share/workspace-vm/docs/OPS-FAST-STORAGE.md
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hang-evidence-sampler.sh 10
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
