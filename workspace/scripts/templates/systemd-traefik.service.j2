[Unit]
Description=Traefik reverse proxy
After=network.target{% if network_enabled %} workspace-network.service{% endif %} opencode.service

[Service]
Type=simple
User={{ container_user }}
ExecStart={{ container_install_root }}/.boot-linux/bin/traefik --configfile=/etc/traefik/traefik.yml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target