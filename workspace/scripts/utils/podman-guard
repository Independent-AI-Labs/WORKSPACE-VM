#!/usr/bin/env bash
# Podman Guard - Blocks destructive commands
# Installed to ${VENV_DIR}/bin/podman, calls real-podman
#
# This wrapper prevents accidental data loss from dangerous podman commands.
# It cannot be bypassed because it IS the podman binary in PATH.

set -euo pipefail

# Resolve the installed path even when the shell guard stages this wrapper
# through /proc/self/fd. Systemd may invoke /usr/local/bin/podman, which can
# also be a symlink to this script.
_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}";; esac
PODMAN_REAL="$(dirname "$(readlink -f "$_SELF")")/real-podman"

# Older guard binaries may not inject SHG_SCRIPT_PATH into staged children.
# AMI_ROOT is preserved by the guard and gives the hermetic install a stable
# fallback without consulting the host PATH.
if [[ ! -x "$PODMAN_REAL" && -n "${AMI_ROOT:-}" ]]; then
    PODMAN_REAL="$AMI_ROOT/.boot-linux/bin/real-podman"
fi

# Ensure real podman exists
if [[ ! -x "$PODMAN_REAL" ]]; then
    echo "ERROR: real-podman not found at $PODMAN_REAL"
    echo "Run 'make core' to fix installation (CI bootstrap-podman)"
    exit 1
fi

block() {
    echo "❌ BLOCKED: $1"
    echo "This command is forbidden to prevent data loss."
    exit 1
}

# Handle empty args
if [[ $# -eq 0 ]]; then
    exec "$PODMAN_REAL"
fi

# Check for destructive commands
case "$1" in
    rm)
        for arg in "$@"; do
            [[ "$arg" == "-a" || "$arg" == "--all" ]] && block "Bulk container removal (rm -a/--all)"
        done
        ;;
    rmi)
        for arg in "$@"; do
            [[ "$arg" == "-a" || "$arg" == "--all" ]] && block "Bulk image removal (rmi -a/--all)"
        done
        ;;
    system)
        case "${2:-}" in
            prune)   block "system prune" ;;
            migrate) block "system migrate (causes state corruption)" ;;
            reset)   block "system reset (destroys all data)" ;;
        esac
        ;;
    volume)
        [[ "${2:-}" == "prune" ]] && block "volume prune"
        if [[ "${2:-}" == "rm" ]]; then
            for arg in "$@"; do
                [[ "$arg" == "-a" || "$arg" == "--all" ]] && block "Bulk volume removal"
            done
        fi
        ;;
    image)
        if [[ "${2:-}" == "prune" ]]; then
            for arg in "$@"; do
                [[ "$arg" == "-a" || "$arg" == "--all" ]] && block "image prune -a"
            done
        fi
        ;;
    container)
        [[ "${2:-}" == "prune" ]] && block "container prune"
        ;;
    network)
        [[ "${2:-}" == "prune" ]] && block "network prune"
        ;;
esac

# Safe - pass through to real podman
exec "$PODMAN_REAL" "$@"
