#!/usr/bin/env bash
# kcadm: Keycloak Admin CLI wrapper
# Executes kcadm.sh inside the workspace-keycloak container
set -euo pipefail

case "${1:-}" in
    --help|-h)
        echo "kcadm - Keycloak Admin CLI wrapper"
        echo ""
        echo "Usage: kcadm <command> [options]"
        echo ""
        echo "Executes kcadm.sh inside the workspace-keycloak container."
        echo "Requires: podman running with workspace-keycloak container."
        echo ""
        echo "Common commands:"
        echo "  config              Configure server connection"
        echo "  get <resource>      Get resources"
        echo "  create <resource>   Create resources"
        echo "  update <resource>   Update resources"
        echo "  delete <resource>   Delete resources"
        echo ""
        echo "Setup: make compose-deploy in WORKSPACE-DATAOPS"
        exit 0
        ;;
    --version|-V)
        _err_tmp="$(mktemp)"
        if ! podman exec workspace-keycloak java -jar /opt/keycloak/lib/quarkus-run.jar -version 2>"$_err_tmp"; then
            if [[ -s "$_err_tmp" ]]; then cat "$_err_tmp" >&2; fi
            echo "unknown"
        fi
        rm -f "$_err_tmp"
        exit 0
        ;;
esac

exec podman exec -it workspace-keycloak /opt/keycloak/bin/kcadm.sh "$@"
