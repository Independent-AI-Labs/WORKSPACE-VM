# Copy this file to .env and set the values for your workspace host.
# Keep .env private. It is ignored by git.
WORKSPACE_SSH_HOST=192.168.50.63
WORKSPACE_SSH_PORT=22
WORKSPACE_AGENT_USER=agent
WORKSPACE_AGENT_PASSWORD=
WORKSPACE_ADMIN_USER=admin
WORKSPACE_ADMIN_PASSWORD=
WORKSPACE_BASE_DIR="$HOME/WORKSPACE-VM"
WORKSPACE_PROJECTS_DIR="$WORKSPACE_BASE_DIR/projects"
WORKSPACE_PROJECT_GLOB=WORKSPACE-*
WORKSPACE_EXCLUDE_PROJECTS=WORKSPACE-VM WORKSPACE-WEB-CONTENT

# Override these when Tabby is installed under a non-standard command name.
WORKSPACE_TABBY_COMMAND=tabby

# Optional: point at a different config file without changing the scripts.
# WORKSPACE_TABBY_CONFIG_DIR=
