#!/usr/bin/env bash
# run: Universal execution wrapper for WORKSPACE Orchestrator
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}";; esac
SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
WORKSPACE_ROOT="$("$SCRIPT_DIR/pwd")"
export WORKSPACE_ROOT

VENV_DIR="$WORKSPACE_ROOT/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"
BOOT_DIR="$WORKSPACE_ROOT/.boot-linux"

if [[ -f "$WORKSPACE_ROOT/.env" ]]; then
    _env_err="$(mktemp)"
    envrc=0
    _env_out="$(grep -v '^#' "$WORKSPACE_ROOT/.env" | xargs 2>"$_env_err")" || envrc=$?
    if [[ $envrc -ne 0 && -s "$_env_err" ]]; then cat "$_env_err" >&2; fi
    [[ -n "$_env_out" ]] && export $_env_out
    rm -f "$_env_err"
fi

export PATH="$BOOT_DIR/bin:$VENV_DIR/bin:$PATH"

# Extension modules live under projects/<PROJECT>/workspace/<pkg>/...
# Add every projects/<PROJECT> dir to PYTHONPATH so `workspace.<pkg>` namespace
# imports resolve against the workspace venv.
PROJECT_PATHS=""
if [[ -d "$WORKSPACE_ROOT/projects" ]]; then
    for project_dir in "$WORKSPACE_ROOT/projects"/*/; do
        [[ -d "${project_dir%/}/workspace" ]] && PROJECT_PATHS="${project_dir%/}:${PROJECT_PATHS}"
    done
fi
export PYTHONPATH="$WORKSPACE_ROOT:${PROJECT_PATHS}${PYTHONPATH:-}"

if [[ "$#" -gt 0 && ("$1" == "-h" || "$1" == "--help") ]]; then
    echo "run: Universal execution wrapper for WORKSPACE Orchestrator"
    echo ""
    echo "Usage: run [subcommand] [args...]"
    echo ""
    echo "Subcommands: python, uv, node, npm, npx, bash, sh, cargo, rustc, go, tests, extras, doctor, banner"
    exit 0
fi

if [[ "$#" -gt 0 && "$1" == "--version" ]]; then
    _err_tmp="$(mktemp)"
    if ! VERSION="$(git -C "$WORKSPACE_ROOT" describe -always -dirty 2>"$_err_tmp")"; then
        if [[ -s "$_err_tmp" ]]; then cat "$_err_tmp" >&2; fi
        VERSION="unknown"
    fi
    rm -f "$_err_tmp"
    echo "run (WORKSPACE Orchestrator) ${VERSION}"
    exit 0
fi

KNOWN_CMDS="python uv node npm npx wrap bash sh tests cargo rustc go extras doctor banner"
if [[ $# -gt 0 ]] && [[ " $KNOWN_CMDS " == *" $1 "* ]]; then
    SUBCOMMAND="$1"
    shift
    ARGS=("$@")
elif [[ $# -gt 0 && -f "$1" ]]; then
    SUBCOMMAND="python"
    ARGS=("$@")
elif [[ $# -eq 0 ]]; then
    SUBCOMMAND="python"
    ARGS=()
else
    echo "Error: Unknown subcommand '$1'" >&2
    exit 1
fi

case "$SUBCOMMAND" in
    python)
        exec "$VENV_PYTHON" "${ARGS[@]}"
        ;;
    tests)
        exec "$VENV_DIR/bin/pytest" "${ARGS[@]}"
        ;;
    uv)
        exec "$BOOT_DIR/bin/uv" "${ARGS[@]}"
        ;;
    node)
        exec "$BOOT_DIR/bin/node" "${ARGS[@]}"
        ;;
    npm)
        exec "$BOOT_DIR/bin/npm" "${ARGS[@]}"
        ;;
    npx)
        exec "$BOOT_DIR/bin/npx" "${ARGS[@]}"
        ;;
    bash)
        exec bash "${ARGS[@]}"
        ;;
    sh)
        exec sh "${ARGS[@]}"
        ;;
    wrap)
        [[ ${#ARGS[@]} -lt 2 ]] && echo "Usage: run wrap <id> <cmd>" >&2 && exit 1
        SVC_ID="${ARGS[0]}"
        CMD=("${ARGS[@]:1}")
        R_DIR="$WORKSPACE_ROOT/.runtime/wrapped/$SVC_ID"
        mkdir -p "$R_DIR"
        PID_F="$R_DIR/pid.lock"
        if [[ -f "$PID_F" ]]; then
            _kill_err="$(mktemp)"
            killrc=0
            kill -0 "$(cat "$PID_F")" 2>"$_kill_err" || killrc=$?
            if [[ $killrc -eq 0 ]]; then
                rm -f "$_kill_err"
                echo "Already running" >&2
                exit 1
            fi
            if [[ -s "$_kill_err" ]]; then cat "$_kill_err" >&2; fi
            rm -f "$_kill_err"
        fi
        nohup "$0" "${CMD[@]}" > "$R_DIR/std.log" 2>&1 &
        echo $! > "$PID_F"
        echo "Started $SVC_ID (PID: $!)"
        ;;
    cargo)
        export RUSTUP_HOME="$BOOT_DIR/rust"
        export CARGO_HOME="$BOOT_DIR/rust"
        exec "$BOOT_DIR/rust/bin/cargo" "${ARGS[@]}"
        ;;
    rustc)
        export RUSTUP_HOME="$BOOT_DIR/rust"
        export CARGO_HOME="$BOOT_DIR/rust"
        exec "$BOOT_DIR/rust/bin/rustc" "${ARGS[@]}"
        ;;
    go)
        exec "$BOOT_DIR/go/bin/go" "${ARGS[@]}"
        ;;
    extras)
        exec "$VENV_PYTHON" "$WORKSPACE_ROOT/workspace/scripts/shell/banner_helper.py" --mode extras "${ARGS[@]}"
        ;;
    doctor)
        exec "$VENV_PYTHON" "$WORKSPACE_ROOT/workspace/scripts/shell/banner_helper.py" --mode doctor "${ARGS[@]}"
        ;;
    banner)
        exec "$VENV_PYTHON" "$WORKSPACE_ROOT/workspace/scripts/shell/banner_helper.py" --mode banner "${ARGS[@]}"
        ;;
esac
