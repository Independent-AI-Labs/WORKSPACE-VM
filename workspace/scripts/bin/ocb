#!/bin/bash
set -euo pipefail

SCRIPT_SOURCE="${SHG_SCRIPT_PATH:-${BASH_SOURCE[0]}}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$SCRIPT_SOURCE")")" && pwd)"
WORKSPACE_ROOT="$SCRIPT_DIR"
while [[ "$WORKSPACE_ROOT" != "/" && ! -f "$WORKSPACE_ROOT/pyproject.toml" ]]; do
    WORKSPACE_ROOT="$(dirname "$WORKSPACE_ROOT")"
done
ORIG_PWD="$PWD"
export WORKSPACE_ROOT && cd "$WORKSPACE_ROOT"

OPN="${OPENCODE_BINARY:-${WORKSPACE_ROOT}/projects/opencode/packages/opencode/dist/opencode-linux-x64/bin/opencode}"
source "$WORKSPACE_ROOT/workspace/scripts/opencode-wrapper.sh" || exit 1

case "$(uname -s):$(uname -m)" in
    Linux:x86_64) ;;
    *)
        echo "ocb: source build is available only on Linux x86_64" >&2
        exit 1
        ;;
esac

echo "[ocb] opencode source-build wrapper"

_ocb_help() {
    echo "ocb - opencode AI agent wrapper (source build)"
    echo "Usage: ocb [--db NAME|--db=NAME|--mono] [task...]"
    echo "  Without arguments: starts interactive opencode session"
    echo "  With arguments:    runs opencode with the given task"
    echo "  Default: one sqlite shard per git root; --mono forces the monolith DB"
    echo "  Use -- before an upstream command to bypass task conversion"
    echo ""
    echo "This wrapper uses the binary built from projects/opencode."
    echo "If the binary is missing, run: make ocb"
}

if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    _ocb_help
    exit 0
fi

if [[ "${1:-}" == "--version" ]] || [[ "${1:-}" == "-V" ]]; then
    if [[ -x "$OPN" ]]; then
        "$OPN" --version
    else
        echo "ocb: binary not built. Run 'make ocb' first." >&2
        exit 1
    fi
    exit 0
fi

for _arg in "$@"; do
    if [[ "$_arg" == "--help" ]] || [[ "$_arg" == "-h" ]]; then
        if [[ ! -x "$OPN" ]]; then
            _ocb_help
            exit 0
        fi
        break
    fi
done

if [[ ! -x "$OPN" ]]; then
    echo "ocb: opencode binary not found at ${OPN}" >&2
    echo "      Run 'make ocb' to build from source." >&2
    exit 1
fi

WELCOME="$(oc_wrapper_welcome)"
printf '%b\n' "$WELCOME" && echo ""
oc_wrapper_prepare "$WORKSPACE_ROOT" "$WELCOME"
cd "$ORIG_PWD"
oc_wrapper_dispatch "$OPN" "$ORIG_PWD" "$@"
