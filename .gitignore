# Ignore the models/ tree (large GGUF weights, .llamafile binaries) but keep
# tracked .args manifests (.args, .args.chat, ...) - small, human-readable,
# reviewable sources of truth for each .llamafile bundle's default behavior.
# NOTE: git cannot re-include a file inside an excluded *directory*, so we
# exclude contents (models/*, models/*/*) and re-include subdirs (!models/*/)
# so git descends and the .args negations below actually take effect.
models/*
!models/*/
models/*/*
!models/*/.args
!models/*/.args.*

# OpenAI-compatible provider config (machine-specific)
opencode.json

# VM artifacts (per-VM state, never committed)
.vms/*
!.vms/.gitkeep

# OpenVPN client config (machine-specific)
workspace/config/vpn/*
!workspace/config/vpn/.gitkeep

# Auto-synced OpenCode transcript bodies (manifest + config stay tracked)
benchmarks/llamafile/transcript_classifier/fixtures/*.txt
benchmarks/llamafile/transcript_classifier/fixtures/manifest.yaml
benchmarks/llamafile/context_audit/

# Ephemeral llamafile benchmark run outputs
docs/benchmarking/llamafile-transcript-classifier/
docs/benchmarking/llamafile-context-audit/

*.coverage.*
.coverage.*
