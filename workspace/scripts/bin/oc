#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" && ! -f "$AMI_ROOT/pyproject.toml" ]]; do
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done
ORIG_PWD="$PWD"
export AMI_ROOT && cd "$AMI_ROOT"
BOOT_DIR="${BOOT_LINUX_DIR:-${AMI_ROOT}/.boot-linux}"
NPX="${BOOT_DIR}/bin/npx"
OPN="${BOOT_DIR}/bin/opencode"

if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    echo "oc — opencode AI agent wrapper with AMI welcome context"
    echo "Usage: oc [task...]"
    echo "  Without arguments: starts interactive opencode session"
    echo "  With arguments:    runs opencode with the given task"
    exit 0
fi
if [[ "$1" == "--version" ]] || [[ "$1" == "-V" ]]; then
    "$OPN" --version 2>/dev/null || echo "unknown"
    exit 0
fi

if [[ ! -x "$OPN" ]]; then
    echo "oc: opencode binary not found. Run 'make install' first." >&2
    exit 1
fi
WELCOME=$("$AMI_ROOT/workspace/scripts/bin/welcome" --plain 2>/dev/null || echo "AMI-AGENTS workspace")
printf '%b\n' "$WELCOME" && echo ""
# Regenerate the instruction file so opencode picks it up fresh each session
printf '%b\n' "$WELCOME" > "${HOME}/.config/opencode/ami-environment.md"
# Deploy opencode user config from workspace template
OC_SRC="$AMI_ROOT/workspace/config/opencode"
OC_DIR="${HOME}/.config/opencode"
mkdir -p "$OC_DIR/plugins"
[ ! -f "$OC_DIR/opencode.jsonc" ] && cp "$OC_SRC/opencode.jsonc" "$OC_DIR/opencode.jsonc"
export OPENCODE_ENABLE_EXA=1
if [[ $# -gt 0 ]]; then
    if [[ "$1" = -* ]]; then
        exec "$OPN" "$@"
    fi
    exec "$OPN" run --dir "$ORIG_PWD" "$@"
else
    exec "$OPN" "$ORIG_PWD"
fi
