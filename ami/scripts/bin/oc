#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AMI_ROOT="$SCRIPT_DIR"
while [[ "$AMI_ROOT" != "/" && ! -f "$AMI_ROOT/pyproject.toml" ]]; do
    AMI_ROOT="$(dirname "$AMI_ROOT")"
done
ORIG_PWD="$PWD"
export AMI_ROOT && cd "$AMI_ROOT"
BOOT_DIR="${BOOT_LINUX_DIR:-${AMI_ROOT}/.boot-linux}"
NPX="${BOOT_DIR}/bin/npx"
OPN="${BOOT_DIR}/bin/opencode"

if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    echo "oc — opencode AI agent wrapper with AMI welcome context"
    echo "Usage: oc [task...]"
    echo "  Without arguments: starts interactive opencode session"
    echo "  With arguments:    runs opencode with the given task"
    exit 0
fi
if [[ "$1" == "--version" ]] || [[ "$1" == "-V" ]]; then
    "$OPN" --version 2>/dev/null || echo "unknown"
    exit 0
fi

WELCOME=$("$AMI_ROOT/ami/scripts/bin/welcome" --plain 2>/dev/null || echo "AMI-AGENTS workspace")
printf '%b\n' "$WELCOME" && echo ""
export OPENCODE_ENABLE_EXA=1
AGENT_NOTE=$'\n\nYou can rename this session with /rename.'
if [[ $# -gt 0 ]]; then
    exec "$NPX" opencode run --dir "$ORIG_PWD" "$WELCOME"$'\n\n'"Task: $*""$AGENT_NOTE"
else
    exec "$NPX" opencode "$ORIG_PWD" --prompt "$WELCOME""$AGENT_NOTE"
fi
