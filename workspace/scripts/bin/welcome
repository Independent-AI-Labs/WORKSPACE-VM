#!/usr/bin/env bash
# welcome: Print the AMI Orchestrator banner
set -euo pipefail
SCRIPT_SOURCE="${SHG_SCRIPT_PATH:-${BASH_SOURCE[0]}}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$SCRIPT_SOURCE")")" && pwd)"
AMI_ROOT="$("$SCRIPT_DIR/pwd")"
export AMI_ROOT
exec bash "$AMI_ROOT/workspace/scripts/shell/ami-banner.sh" "$@"
