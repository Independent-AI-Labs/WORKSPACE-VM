#!/usr/bin/env bash
# pwd: WORKSPACE root directory management
# Gets or sets the WORKSPACE_ROOT persistently
#
# Usage:
#   pwd              # Print current WORKSPACE_ROOT
#   pwd --set PATH   # Set WORKSPACE_ROOT persistently
#   pwd --reset      # Reset to default (agents/ directory)
#   pwd --env        # Output shell export statement
#
# The root is stored in ~/.config/workspace/root and exported as WORKSPACE_ROOT
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/workspace"
ROOT_FILE="$CONFIG_DIR/root"

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}";; esac
SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"

# Default: agents directory
# Walk up looking for markers
get_default_root() {
    local curr
    curr="$SCRIPT_DIR"
    while [[ "$curr" != "/" ]]; do
        if [[ -f "$curr/pyproject.toml" || -d "$curr/.git" ]]; then
            echo "$curr"
            return 0
        fi
        curr="$(dirname "$curr")"
    done
    # Last resort: resolve from git root, else fail explicitly.
    # stderr is inherited (surfaced, never captured to a discardable file).
    if git rev-parse --show-toplevel; then
        return 0
    fi
    echo "Error: cannot determine WORKSPACE root (no pyproject.toml/.git marker, not in a git repo)" >&2
    return 1
}

# Get current root (from file, env, or default)
get_root() {
    if [[ -f "$ROOT_FILE" ]]; then
        cat "$ROOT_FILE"
    elif [[ -n "${WORKSPACE_ROOT:-}" ]]; then
        echo "$WORKSPACE_ROOT"
    else
        get_default_root
    fi
}

# Set root persistently
set_root() {
    local new_root="$1"

    # Resolve to absolute path
    if [[ -d "$new_root" ]]; then
        new_root="$(cd "$new_root" && pwd)"
    else
        echo "Error: Directory does not exist: $new_root" >&2
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"
    echo "$new_root" > "$ROOT_FILE"
    echo "WORKSPACE_ROOT set to: $new_root"
}

# Reset to default
reset_root() {
    if [[ -f "$ROOT_FILE" ]]; then
        rm "$ROOT_FILE"
    fi
    echo "WORKSPACE_ROOT reset to default: $(get_default_root)"
}

# Main
case "${1:-}" in
    --set)
        [[ -z "${2:-}" ]] && echo "Usage: pwd --set PATH" >&2 && exit 1
        set_root "$2"
        ;;
    --reset)
        reset_root
        ;;
    --env)
        echo "export WORKSPACE_ROOT=\"$(get_root)\""
        ;;
    --help|-h)
        echo "pwd: WORKSPACE root directory management"
        echo ""
        echo "Usage:"
        echo "  pwd              Print current WORKSPACE_ROOT"
        echo "  pwd --set PATH   Set WORKSPACE_ROOT persistently"
        echo "  pwd --reset      Reset to default (agents/)"
        echo "  pwd --env        Output shell export statement"
        echo ""
        echo "Current: $(get_root)"
        ;;
    "")
        get_root
        ;;
    *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
esac
